# Copy to .env for local development. Neither file is required to build —
# both endpoints fall back to sensible defaults.

# Where the application form POSTs. Change this (and only this) if you move
# the form backend off all-inkl — see README, "Moving off all-inkl".
# Leave empty on Vercel (mailto apply flow). Set to /api/apply.php only on All-Inkl.
PUBLIC_APPLY_ENDPOINT=

# Where the employer brief and contact forms POST.
# Contact forms removed on Vercel — calendar + hello@ only.
PUBLIC_CONTACT_ENDPOINT=
