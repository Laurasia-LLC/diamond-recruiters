---
import { CONTACT } from '../consts';

interface Props {
  /** 'employer' asks hiring questions; 'general' is a plain enquiry form. */
  variant?: 'employer' | 'general';
  id?: string;
}

const { variant = 'general', id = 'contact-form' } = Astro.props;
const isEmployer = variant === 'employer';

const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? '/api/contact.php';

const field =
  'w-full rounded-xl border border-ink-200 bg-white px-4 py-3 text-[0.95rem] text-ink-900 ' +
  'placeholder:text-ink-300 transition-colors duration-200 ' +
  'hover:border-ink-300 focus:border-ice-500 focus:outline-none focus:ring-4 focus:ring-ice-500/12';
const label = 'block text-sm font-medium text-ink-800';
const hint = 'mt-1.5 text-xs text-ink-500';
---

<form
  id={id}
  class="contact-form scroll-mt-28"
  action={endpoint}
  method="post"
  novalidate
>
  <input type="hidden" name="form_type" value={variant} />
  <input type="hidden" name="page_url" value="" data-page-url />
  <div class="absolute left-[-9999px]" aria-hidden="true">
    <label>
      Fax number
      <input type="text" name="fax" tabindex="-1" autocomplete="off" />
    </label>
  </div>
  <input type="hidden" name="rendered_at" value="" data-rendered-at />

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label class={label} for={`${id}-name`}>Your name <span class="text-copper-500">*</span></label>
      <input
        class={`${field} mt-2`}
        id={`${id}-name`}
        name="name"
        type="text"
        required
        autocomplete="name"
        placeholder="Alex Moreau"
      />
    </div>

    <div>
      <label class={label} for={`${id}-email`}>
        {isEmployer ? 'Work email' : 'Email'} <span class="text-copper-500">*</span>
      </label>
      <input
        class={`${field} mt-2`}
        id={`${id}-email`}
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="you@company.com"
      />
    </div>

    {
      isEmployer && (
        <div>
          <label class={label} for={`${id}-company`}>
            Company <span class="text-copper-500">*</span>
          </label>
          <input
            class={`${field} mt-2`}
            id={`${id}-company`}
            name="company"
            type="text"
            required
            autocomplete="organization"
            placeholder="Manufacturer or distributor"
          />
        </div>
      )
    }

    <div>
      <label class={label} for={`${id}-phone`}>Phone</label>
      <input
        class={`${field} mt-2`}
        id={`${id}-phone`}
        name="phone"
        type="tel"
        autocomplete="tel"
        placeholder="(555) 123-4567"
      />
    </div>

    {
      isEmployer && (
        <>
          <div>
            <label class={label} for={`${id}-role`}>
              Role you are hiring <span class="text-copper-500">*</span>
            </label>
            <input
              class={`${field} mt-2`}
              id={`${id}-role`}
              name="role"
              type="text"
              required
              placeholder="Territory Sales Engineer"
            />
          </div>

          <div>
            <label class={label} for={`${id}-territory`}>
              Territory or location <span class="text-copper-500">*</span>
            </label>
            <input
              class={`${field} mt-2`}
              id={`${id}-territory`}
              name="territory"
              type="text"
              required
              placeholder="Upper Midwest"
            />
          </div>

          <div>
            <label class={label} for={`${id}-band`}>Base and OTE band</label>
            <input
              class={`${field} mt-2`}
              id={`${id}-band`}
              name="band"
              type="text"
              placeholder="$95K base / $150K OTE"
            />
            <p class={hint}>If you have one. If you do not, we will help you set it.</p>
          </div>

          <div>
            <label class={label} for={`${id}-timing`}>When do you need someone in seat?</label>
            <select class={`${field} mt-2`} id={`${id}-timing`} name="timing">
              <option value="">Select…</option>
              <option>Yesterday — the territory is uncovered</option>
              <option>Within 30 days</option>
              <option>This quarter</option>
              <option>Planning ahead, no fixed date</option>
            </select>
          </div>
        </>
      )
    }

    <div class="sm:col-span-2">
      <label class={label} for={`${id}-message`}>
        {isEmployer ? 'What does good look like in this seat?' : 'How can we help?'}{' '}
        {!isEmployer && <span class="text-copper-500">*</span>}
      </label>
      <textarea
        class={`${field} mt-2 resize-y`}
        id={`${id}-message`}
        name="message"
        rows="5"
        required={!isEmployer}
        placeholder={isEmployer
          ? 'Product line, the accounts that matter, what the last person in the seat got wrong.'
          : 'Tell us what you need.'}></textarea>
    </div>

    <div class="sm:col-span-2">
      <label class="flex cursor-pointer items-start gap-3">
        <input
          class="mt-0.5 h-4.5 w-4.5 shrink-0 cursor-pointer rounded border-ink-300 text-ice-600 focus:ring-2 focus:ring-ice-500/40"
          name="consent"
          type="checkbox"
          required
        />
        <span class="text-sm leading-relaxed text-ink-600">
          I agree that Diamond Recruiters may use this information to respond to my enquiry,
          as described in the <a
            href="/privacy"
            class="text-ice-600 underline underline-offset-2 hover:text-ice-500">Privacy Policy</a
          >. <span class="text-copper-500">*</span>
        </span>
      </label>
    </div>
  </div>

  <div class="mt-7 flex flex-col gap-4 sm:flex-row sm:items-center">
    <button
      type="submit"
      class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full bg-ink-900 px-7 py-3.5 text-base font-medium text-white shadow-sm transition-all duration-200 ease-out-expo hover:-translate-y-px hover:bg-ink-700 hover:shadow-md disabled:pointer-events-none disabled:opacity-60"
      data-submit
    >
      <span data-submit-label>{isEmployer ? 'Send the brief' : 'Send message'}</span>
      <svg class="hidden h-4 w-4 animate-spin" data-spinner viewBox="0 0 24 24" fill="none">
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" opacity="0.25"></circle>
        <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"
        ></path>
      </svg>
    </button>

    <p class="text-sm text-ink-500">
      Or email <a
        href={`mailto:${CONTACT.general}`}
        class="text-ice-600 underline underline-offset-2">{CONTACT.general}</a
      >
    </p>
  </div>

  <p
    class="mt-5 hidden rounded-xl border border-copper-500/30 bg-copper-500/8 px-4 py-3 text-sm text-copper-500"
    data-error
    role="alert"
  >
  </p>

  <div
    class="mt-5 hidden rounded-xl border border-ice-500/30 bg-ice-100/60 px-5 py-4"
    data-success
    role="status"
  >
    <p class="font-medium text-ink-900">Message sent.</p>
    <p class="mt-1.5 text-sm leading-relaxed text-ink-600">
      We reply to everything within one business day — usually sooner.
    </p>
  </div>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('form.contact-form').forEach((form) => {
    const errorBox = form.querySelector<HTMLElement>('[data-error]');
    const successBox = form.querySelector<HTMLElement>('[data-success]');
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]');
    const spinner = form.querySelector<HTMLElement>('[data-spinner]');
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    const originalLabel = submitLabel?.textContent ?? 'Send';

    const stamp = form.querySelector<HTMLInputElement>('[data-rendered-at]');
    if (stamp) stamp.value = String(Math.floor(Date.now() / 1000));

    const pageUrl = form.querySelector<HTMLInputElement>('[data-page-url]');
    if (pageUrl) pageUrl.value = window.location.href;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorBox?.classList.add('hidden');

      if (!form.reportValidity()) return;

      if (submit) submit.disabled = true;
      spinner?.classList.remove('hidden');
      if (submitLabel) submitLabel.textContent = 'Sending…';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        const result = await response.json().catch(() => null);

        if (!response.ok || !result?.ok) {
          throw new Error(result?.error ?? 'Request failed');
        }

        form.querySelectorAll('.grid, .mt-7').forEach((el) => el.classList.add('hidden'));
        successBox?.classList.remove('hidden');
        successBox?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (error) {
        if (errorBox) {
          errorBox.textContent =
            error instanceof Error && error.message !== 'Request failed'
              ? error.message
              : 'Something went wrong. Please email us directly and we will pick it up.';
          errorBox.classList.remove('hidden');
        }
        if (submit) submit.disabled = false;
        spinner?.classList.add('hidden');
        if (submitLabel) submitLabel.textContent = originalLabel;
      }
    });
  });
</script>
