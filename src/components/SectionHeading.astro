---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  tone?: 'light' | 'dark';
  class?: string;
}

const {
  eyebrow,
  title,
  lead,
  align = 'left',
  tone = 'dark',
  class: className = '',
} = Astro.props;

const alignCls = align === 'center' ? 'text-center mx-auto' : '';
const eyebrowCls = tone === 'light' ? 'text-ice-400' : 'text-ice-600';
const titleCls = tone === 'light' ? 'text-white' : 'text-ink-950';
const leadCls = tone === 'light' ? 'text-ink-200' : 'text-ink-600';
---

<div class={`max-w-2xl ${alignCls} ${className}`}>
  {eyebrow && <p class={`eyebrow ${eyebrowCls}`}>{eyebrow}</p>}
  <h2 class={`mt-3 text-3xl leading-[1.15] sm:text-4xl ${titleCls}`}>{title}</h2>
  {lead && <p class={`mt-5 text-lg leading-relaxed ${leadCls}`}>{lead}</p>}
  <slot />
</div>
