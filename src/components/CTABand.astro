---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import texture from '../assets/texture-pipes-mono.jpg';

interface Props {
  eyebrow?: string;
  title: string;
  lead: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  eyebrow = 'Next step',
  title,
  lead,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
} = Astro.props;
---

<section class="relative overflow-hidden bg-ink-950">
  <Image
    src={texture}
    alt=""
    widths={[800, 1400, 2000]}
    sizes="100vw"
    class="absolute inset-0 h-full w-full object-cover opacity-15 grayscale"
    loading="lazy"
    aria-hidden="true"
  />
  <div
    class="absolute inset-0 bg-linear-to-br from-ink-950 via-ink-950/85 to-ink-900/70"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-24">
    <div class="max-w-3xl">
      <p class="eyebrow text-ice-400">{eyebrow}</p>
      <h2 class="mt-3 text-3xl leading-[1.15] text-white sm:text-4xl lg:text-[2.75rem]">
        {title}
      </h2>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-200">{lead}</p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <Button href={primaryHref} variant="onDark" size="lg">{primaryLabel}</Button>
        {
          secondaryHref && (
            <Button
              href={secondaryHref}
              size="lg"
              class="bg-transparent text-white ring-1 ring-ink-700 hover:bg-ink-900 hover:ring-ink-600"
            >
              {secondaryLabel}
            </Button>
          )
        }
      </div>
    </div>
  </div>
</section>
