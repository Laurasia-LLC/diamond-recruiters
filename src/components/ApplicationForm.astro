---
import { APPLY_ENDPOINT, UPLOAD, CONTACT } from '../consts';

interface Props {
  /** Pre-fills the role field. Omit for the general "send us your CV" form. */
  roleTitle?: string;
  roleSlug?: string;
  id?: string;
  compact?: boolean;
}

const { roleTitle = '', roleSlug = '', id = 'apply', compact = false } = Astro.props;

const useMailto = !APPLY_ENDPOINT;
const mailtoHref = `mailto:${CONTACT.applications}?subject=${encodeURIComponent(
  roleTitle ? `Application — ${roleTitle}` : 'Application — Diamond Recruiters'
)}&body=${encodeURIComponent('Name:\nCity:\nOTE needed:\nTravel:\nLinkedIn:\n\nPlease attach your resume to this email.')}`;

const field =
  'w-full rounded-xl border border-ink-200 bg-white px-4 py-3 text-[0.95rem] text-ink-900 ' +
  'placeholder:text-ink-300 transition-colors duration-200 ' +
  'hover:border-ink-300 focus:border-ice-500 focus:outline-none focus:ring-4 focus:ring-ice-500/12';
const label = 'block text-sm font-medium text-ink-800';
const hint = 'mt-1.5 text-xs text-ink-500';
---

{
  useMailto ? (
    <div id={id} class="scroll-mt-28 rounded-2xl border border-ink-100 bg-sand-50 p-7 sm:p-8">
      <p class="text-[0.95rem] leading-relaxed text-ink-700">
        Send your resume by email to{' '}
        <a href={`mailto:${CONTACT.applications}`} class="font-medium text-ice-600 underline">
          {CONTACT.applications}
        </a>
        . Include your base city, OTE, travel willingness and LinkedIn URL.
      </p>
      <a
        href={mailtoHref}
        class="mt-6 inline-flex items-center justify-center rounded-full bg-ink-950 px-6 py-3 text-sm font-semibold text-white hover:bg-ink-800"
      >
        Open application email
      </a>
    </div>
  ) : (
<form
  id={id}
  class="apply-form scroll-mt-28"
  action={APPLY_ENDPOINT}
  method="post"
  enctype="multipart/form-data"
  novalidate
>
  <input type="hidden" name="role_title" value={roleTitle} />
  <input type="hidden" name="role_slug" value={roleSlug} />
  <input type="hidden" name="page_url" value="" data-page-url />
  <!-- Spam trap: bots fill hidden fields, humans never see them. -->
  <div class="absolute left-[-9999px]" aria-hidden="true">
    <label>
      Company website
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>
  <input type="hidden" name="rendered_at" value="" data-rendered-at />

  <div class={compact ? 'grid gap-5' : 'grid gap-5 sm:grid-cols-2'}>
    <div class={compact ? '' : 'sm:col-span-1'}>
      <label class={label} for={`${id}-name`}>Full name <span class="text-copper-500">*</span></label>
      <input
        class={`${field} mt-2`}
        id={`${id}-name`}
        name="name"
        type="text"
        required
        autocomplete="name"
        placeholder="Jordan Reyes"
      />
    </div>

    <div>
      <label class={label} for={`${id}-email`}>Email <span class="text-copper-500">*</span></label>
      <input
        class={`${field} mt-2`}
        id={`${id}-email`}
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="you@example.com"
      />
    </div>

    <div>
      <label class={label} for={`${id}-phone`}>Phone</label>
      <input
        class={`${field} mt-2`}
        id={`${id}-phone`}
        name="phone"
        type="tel"
        autocomplete="tel"
        placeholder="(555) 123-4567"
      />
    </div>

    <div>
      <label class={label} for={`${id}-city`}>
        Base city <span class="text-copper-500">*</span>
      </label>
      <input
        class={`${field} mt-2`}
        id={`${id}-city`}
        name="base_city"
        type="text"
        required
        placeholder="Houston, TX"
      />
      <p class={hint}>Where you are based today, not where you would relocate.</p>
    </div>

    <div>
      <label class={label} for={`${id}-ote`}>
        Salary expectation, OTE <span class="text-copper-500">*</span>
      </label>
      <input
        class={`${field} mt-2`}
        id={`${id}-ote`}
        name="ote_expectation"
        type="text"
        required
        placeholder="$150,000"
      />
      <p class={hint}>A number, not a range, if you can. We work to it honestly.</p>
    </div>

    <div>
      <label class={label} for={`${id}-travel`}>
        Travel you will take <span class="text-copper-500">*</span>
      </label>
      <select class={`${field} mt-2`} id={`${id}-travel`} name="travel" required>
        <option value="">Select…</option>
        <option>Up to 25% — day trips, home most nights</option>
        <option>Up to 50% — regional, overnights expected</option>
        <option>Up to 75% — heavy travel, multi-state</option>
        <option>Open — whatever the territory needs</option>
      </select>
    </div>

    <div class={compact ? '' : 'sm:col-span-2'}>
      <label class={label} for={`${id}-linkedin`}>LinkedIn profile</label>
      <input
        class={`${field} mt-2`}
        id={`${id}-linkedin`}
        name="linkedin"
        type="url"
        placeholder="https://www.linkedin.com/in/…"
      />
    </div>

    <div class={compact ? '' : 'sm:col-span-2'}>
      <label class={label} for={`${id}-resume`}>
        Resume <span class="text-copper-500">*</span>
      </label>
      <input
        class="mt-2 w-full cursor-pointer rounded-xl border border-dashed border-ink-300 bg-white px-4 py-3.5 text-sm text-ink-700 transition-colors file:mr-4 file:cursor-pointer file:rounded-full file:border-0 file:bg-ink-900 file:px-4 file:py-2 file:text-sm file:font-medium file:text-white hover:border-ice-500 hover:bg-ice-100/30"
        id={`${id}-resume`}
        name="resume"
        type="file"
        required
        accept={UPLOAD.accept}
      />
      <p class={hint}>{UPLOAD.acceptLabel}, up to {UPLOAD.maxLabel}.</p>
    </div>

    <div class={compact ? '' : 'sm:col-span-2'}>
      <label class={label} for={`${id}-message`}>
        One number you can defend, and anything else we should know
      </label>
      <textarea
        class={`${field} mt-2 resize-y`}
        id={`${id}-message`}
        name="message"
        rows="4"
        placeholder="Quota attainment, YoY growth, a named account win — plus anything about timing or territory we should know."
      ></textarea>
    </div>

    <div class={compact ? '' : 'sm:col-span-2'}>
      <label class="flex cursor-pointer items-start gap-3">
        <input
          class="mt-0.5 h-4.5 w-4.5 shrink-0 cursor-pointer rounded border-ink-300 text-ice-600 focus:ring-2 focus:ring-ice-500/40"
          name="consent"
          type="checkbox"
          required
        />
        <span class="text-sm leading-relaxed text-ink-600">
          I agree that Diamond Recruiters may store and process this information to consider
          me for roles, as described in the <a
            href="/privacy"
            class="text-ice-600 underline underline-offset-2 hover:text-ice-500">Privacy Policy</a
          >. <span class="text-copper-500">*</span>
        </span>
      </label>
    </div>
  </div>

  <div class="mt-7 flex flex-col gap-4 sm:flex-row sm:items-center">
    <button
      type="submit"
      class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full bg-ink-900 px-7 py-3.5 text-base font-medium text-white shadow-sm transition-all duration-200 ease-out-expo hover:-translate-y-px hover:bg-ink-700 hover:shadow-md disabled:pointer-events-none disabled:opacity-60"
      data-submit
    >
      <span data-submit-label>Send application</span>
      <svg
        class="hidden h-4 w-4 animate-spin"
        data-spinner
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" opacity="0.25"
        ></circle>
        <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"
        ></path>
      </svg>
    </button>

    <p class="text-sm text-ink-500">
      Or email <a
        href={`mailto:${CONTACT.applications}`}
        class="text-ice-600 underline underline-offset-2">{CONTACT.applications}</a
      > directly.
    </p>
  </div>

  <p
    class="mt-5 hidden rounded-xl border border-copper-500/30 bg-copper-500/8 px-4 py-3 text-sm text-copper-500"
    data-error
    role="alert"
  >
  </p>

  <div
    class="mt-5 hidden rounded-xl border border-ice-500/30 bg-ice-100/60 px-5 py-4"
    data-success
    role="status"
  >
    <p class="font-medium text-ink-900">Application received.</p>
    <p class="mt-1.5 text-sm leading-relaxed text-ink-600">
      We read every one. If there is a fit you will hear from a person, not an autoresponder,
      when we have reviewed your application.
    </p>
  </div>
</form>
  )
}

<script is:inline>
  const MAX_BYTES = 8 * 1024 * 1024;

  document.querySelectorAll('form.apply-form').forEach((form) => {
    const errorBox = form.querySelector('[data-error]');
    const successBox = form.querySelector('[data-success]');
    const submit = form.querySelector('[data-submit]');
    const spinner = form.querySelector('[data-spinner]');
    const submitLabel = form.querySelector('[data-submit-label]');

    // Stamped client-side so the server can reject sub-second bot submissions.
    const stamp = form.querySelector('[data-rendered-at]');
    if (stamp) stamp.value = String(Math.floor(Date.now() / 1000));

    const pageUrl = form.querySelector('[data-page-url]');
    if (pageUrl) pageUrl.value = window.location.href;

    const showError = (msg) => {
      if (!errorBox) return;
      errorBox.textContent = msg;
      errorBox.classList.remove('hidden');
      errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };

    const setBusy = (busy) => {
      if (submit) submit.disabled = busy;
      spinner?.classList.toggle('hidden', !busy);
      if (submitLabel) submitLabel.textContent = busy ? 'Sending…' : 'Send application';
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorBox?.classList.add('hidden');

      if (!form.reportValidity()) return;

      const fileInput = form.querySelector('input[type="file"]');
      const file = fileInput?.files?.[0];
      if (file && file.size > MAX_BYTES) {
        showError('That resume is over 8 MB. Please attach a smaller file or email it to us.');
        return;
      }

      setBusy(true);

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        const result = await response.json().catch(() => null);

        if (!response.ok || !result?.ok) {
          showError(
            result?.error ??
              'Something went wrong sending that. Please email your resume to apply@diamond-recruiters.com.'
          );
          setBusy(false);
          return;
        }

        form.querySelectorAll('.grid, .mt-7').forEach((el) => el.classList.add('hidden'));
        successBox?.classList.remove('hidden');
        successBox?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch {
        showError(
          'We could not reach the server. Please email your resume to apply@diamond-recruiters.com.'
        );
        setBusy(false);
      }
    });
  });
</script>
