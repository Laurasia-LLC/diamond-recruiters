---
import { REFERENCES, REFERENCES_ATTRIBUTION } from '../consts';

interface Props {
  /** Show the attribution explainer (full page). */
  showAttribution?: boolean;
  /** Limit cards for teasers on the homepage. */
  limit?: number;
  class?: string;
}

const { showAttribution = false, limit, class: className = '' } = Astro.props;
const items = limit != null ? REFERENCES.slice(0, limit) : REFERENCES;
---

<div class={className}>
  {
    showAttribution && (
      <div class="rounded-2xl border border-ink-100 bg-sand-50 p-7 sm:p-8">
        <h2 class="font-display text-lg font-semibold text-ink-950">{REFERENCES_ATTRIBUTION.title}</h2>
        <p class="mt-3 text-[0.95rem] leading-relaxed text-ink-600">{REFERENCES_ATTRIBUTION.body}</p>
        <p class="mt-4 text-sm text-ink-500">
          Source:{' '}
          <a
            href={REFERENCES_ATTRIBUTION.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-ice-600 underline underline-offset-4 hover:text-ice-500"
          >
            {REFERENCES_ATTRIBUTION.sourceLabel}
          </a>
        </p>
      </div>
    )
  }

  <ul class:list={[showAttribution && 'mt-12', 'grid gap-7 lg:grid-cols-2']}>
    {
      items.map((ref) => (
        <li class="flex flex-col rounded-2xl bg-white p-7 ring-1 ring-ink-100 sm:p-8">
          <figure class="flex flex-1 flex-col">
            <blockquote class="flex-1 text-[1.02rem] leading-relaxed text-ink-800">
              <span aria-hidden="true" class="text-ice-500">
                “
              </span>
              {ref.quote}
              <span aria-hidden="true" class="text-ice-500">
                ”
              </span>
            </blockquote>
            <figcaption class="mt-6 border-t border-ink-100 pt-6">
              <p class="font-display font-semibold text-ink-950">{ref.contact}</p>
              <p class="mt-1 text-sm text-ink-600">{ref.role}</p>
              <p class="mt-2 text-sm font-medium text-ink-800">{ref.company}</p>
              <p class="mt-1 text-xs text-ink-500">{ref.industry}</p>
              {'relationship' in ref && ref.relationship && (
                <p class="mt-2 text-xs text-ink-400">{ref.relationship} (on source)</p>
              )}
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</div>
