---
import { bookingFor, navFor } from '../consts';
import type { Locale } from '../lib/locale';
import { detectLocaleFromPath, localePath, logicalPath } from '../lib/locale';
import Logo from './Logo.astro';

interface Props {
  overDark?: boolean;
  locale?: Locale;
}

const { overDark = true, locale = detectLocaleFromPath(Astro.url.pathname) } = Astro.props;

const navLinks = navFor(locale).map((link) => ({
  ...link,
  href: localePath(locale, link.href),
}));

const path = logicalPath(Astro.url.pathname);
const isActive = (href: string) => {
  const logical = logicalPath(href);
  return path === logical || path.startsWith(`${logical}/`);
};

const booking = bookingFor(locale);
const home = localePath(locale, '/');
const employersBrief = `${localePath(locale, '/for-employers')}#brief`;
const cta =
  locale === 'de' ? 'Suche starten' : 'Start a search';
---

<header
  id="site-header"
  class:list={[
    'dr-header sticky top-0 z-50 border-b border-transparent transition-all duration-300 ease-out-expo',
    overDark && 'over-dark',
  ]}
>
  <div class="mx-auto flex max-w-7xl items-center gap-6 px-5 py-4 lg:px-8">
    <a href={home} class="shrink-0" aria-label="Diamond Recruiters — home">
      <Logo />
    </a>

    <nav class="ml-auto hidden items-center gap-1 lg:flex" aria-label="Main">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'dr-nav-link relative rounded-full px-3.5 py-2 text-[0.925rem] font-medium transition-colors',
              isActive(link.href) && 'is-active',
            ]}
          >
            {link.label}
            {isActive(link.href) && (
              <span class="absolute inset-x-3.5 -bottom-0.5 h-px bg-ice-500" />
            )}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto hidden lg:ml-3 lg:block">
      <a
        href={booking.url}
        target="_blank"
        rel="noopener noreferrer"
        class="dr-header-cta inline-flex items-center justify-center whitespace-nowrap rounded-full px-5 py-2.5 text-sm font-medium shadow-sm transition-all duration-200 ease-out-expo hover:-translate-y-px hover:shadow-md"
      >
        {locale === 'de' ? 'Call buchen' : 'Book a call'}
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="dr-menu-toggle ml-auto rounded-full p-2 transition-colors lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path id="menu-icon-open" d="M3.5 7h17M3.5 12h17M3.5 17h17" stroke-linecap="round"></path>
        <path
          id="menu-icon-close"
          class="hidden"
          d="M5.5 5.5l13 13M18.5 5.5l-13 13"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-ink-100 bg-sand-50 lg:hidden"
  >
    <nav class="mx-auto flex max-w-7xl flex-col gap-1 px-5 py-4" aria-label="Mobile">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'rounded-xl px-3 py-3 text-base font-medium transition-colors',
              isActive(link.href)
                ? 'bg-ink-100 text-ink-900'
                : 'text-ink-700 hover:bg-ink-100/60',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={employersBrief}
        class="mt-2 inline-flex w-full items-center justify-center rounded-full bg-ink-900 px-5 py-3 font-medium text-white transition-colors hover:bg-ink-700"
      >
        {cta}
      </a>
    </nav>
  </div>
</header>

<style is:global>
  .dr-header .dr-nav-link {
    color: var(--color-ink-600);
  }
  .dr-header .dr-nav-link:hover,
  .dr-header .dr-nav-link.is-active {
    color: var(--color-ink-900);
  }

  .dr-header .dr-header-cta {
    background-color: var(--color-ink-900);
    color: #fff;
  }
  .dr-header .dr-header-cta:hover {
    background-color: var(--color-ink-700);
  }

  .dr-header .dr-menu-toggle {
    color: var(--color-ink-800);
  }
  .dr-header .dr-menu-toggle:hover {
    background-color: var(--color-ink-100);
  }

  .dr-header.over-dark:not(.is-scrolled):not(.menu-open) .dr-logo-word {
    color: #fff;
  }
  .dr-header.over-dark:not(.is-scrolled):not(.menu-open) .dr-logo-sub {
    color: var(--color-ink-200);
  }
  .dr-header.over-dark:not(.is-scrolled):not(.menu-open) .dr-nav-link {
    color: rgb(255 255 255 / 0.78);
  }
  .dr-header.over-dark:not(.is-scrolled):not(.menu-open) .dr-nav-link:hover,
  .dr-header.over-dark:not(.is-scrolled):not(.menu-open) .dr-nav-link.is-active {
    color: #fff;
  }
  .dr-header.over-dark:not(.is-scrolled):not(.menu-open) .dr-header-cta {
    background-color: #fff;
    color: var(--color-ink-950);
  }
  .dr-header.over-dark:not(.is-scrolled):not(.menu-open) .dr-header-cta:hover {
    background-color: var(--color-ice-100);
  }
  .dr-header.over-dark:not(.is-scrolled):not(.menu-open) .dr-menu-toggle {
    color: #fff;
  }
  .dr-header.over-dark:not(.is-scrolled):not(.menu-open) .dr-menu-toggle:hover {
    background-color: rgb(255 255 255 / 0.15);
  }

  .dr-header.over-dark:not(.is-scrolled):not(.menu-open) .dr-logo-stroke {
    stroke: var(--color-ice-100);
  }

  .dr-header.is-scrolled {
    background-color: rgb(250 248 245 / 0.9);
    backdrop-filter: blur(12px);
    border-bottom-color: var(--color-ink-100);
    box-shadow: 0 1px 2px 0 rgb(10 26 43 / 0.05);
  }

  .dr-header.menu-open {
    background-color: var(--color-sand-50);
  }
  .dr-header.menu-open .dr-logo-word,
  .dr-header.menu-open .dr-nav-link {
    color: var(--color-ink-900);
  }
  .dr-header.menu-open .dr-logo-sub {
    color: var(--color-ink-500);
  }
  .dr-header.menu-open .dr-menu-toggle {
    color: var(--color-ink-800);
  }
  .dr-header.menu-open .dr-logo-stroke {
    stroke: var(--color-ink-900);
  }
</style>

<script>
  const header = document.getElementById('site-header');

  const sync = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 8);
  };

  sync();
  window.addEventListener('scroll', sync, { passive: true });

  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    header?.classList.toggle('menu-open', open);
  });
</script>
