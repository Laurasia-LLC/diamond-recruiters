---
import { CONTACT, LEGAL, siteFor } from '../consts';
import type { Locale } from '../lib/locale';
import { alternateFor, canonicalFor, logicalPath } from '../lib/locale';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | null;
  locale?: Locale;
}

const {
  title,
  description,
  image = '/og-default.png',
  noindex = false,
  schema = null,
  locale = 'en',
} = Astro.props;

const site = siteFor(locale);
const logical = logicalPath(Astro.url.pathname);
const canonical = canonicalFor(locale, logical);
const alternate = alternateFor(locale, logical);
const alternateLocale = locale === 'en' ? 'de' : 'en';

const descriptionText = description ?? site.description;
const ogImage = new URL(image, site.url);
const fullTitle =
  title === site.name ? `${site.name} — ${site.tagline}` : `${title} | ${site.name}`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'EmploymentAgency',
  name: site.name,
  legalName: LEGAL.entityName,
  url: site.url,
  description: descriptionText,
  email: CONTACT.general,
  address: {
    '@type': 'PostalAddress',
    streetAddress: CONTACT.address.line1,
    addressLocality: CONTACT.address.city,
    addressRegion: CONTACT.address.region,
    postalCode: CONTACT.address.postalCode,
    addressCountry: CONTACT.address.country,
  },
  areaServed: { '@type': 'Country', name: locale === 'de' ? 'United States' : 'United States' },
  knowsAbout: [
    'Industrial automation sales recruitment',
    'Process instrumentation recruitment',
    'Sales engineer recruitment',
    'Flow control and valve automation hiring',
  ],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={descriptionText} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang={locale === 'en' ? 'en' : 'de'} href={canonical} />
<link rel="alternate" hreflang={alternateLocale} href={alternate} />
<link rel="alternate" hreflang="x-default" href={canonicalFor('en', logical)} />
{noindex && <meta name="robots" content="noindex, follow" />}

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={descriptionText} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={site.locale} />
<meta property="og:locale:alternate" content={siteFor(alternateLocale).locale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={descriptionText} />
<meta name="twitter:image" content={ogImage} />

<meta name="theme-color" content="#0a1a2b" />

<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} is:inline />
{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />}
