---
import { CONTACT, LEGAL, BOOKING, FOUNDER } from '../consts';

interface Props {
  /** Render the public booking link. Employer-facing blocks only. */
  booking?: boolean;
  /** Shown above the name. Keep it factual. */
  eyebrow?: string;
  /** One or two sentences on what dealing with this person means. */
  lead?: string;
  class?: string;
}

const {
  booking = false,
  eyebrow = 'Who you speak to',
  lead = FOUNDER.lead,
  class: className = '',
} = Astro.props;

const linkedin = CONTACT.social.linkedin || null;
---

<div class={`rounded-2xl bg-white p-7 ring-1 ring-ink-100 sm:p-8 ${className}`}>
  <p class="eyebrow text-ice-600">{eyebrow}</p>

  <p class="mt-3 font-display text-xl font-semibold tracking-tight text-ink-950">
    {LEGAL.responsibleParty}
  </p>
  {
    LEGAL.responsibleTitle && (
      <p class="mt-1 text-sm text-ink-500">{LEGAL.responsibleTitle}, Diamond Recruiters</p>
    )
  }

  <p class="mt-4 text-[0.95rem] leading-relaxed text-ink-600">{lead}</p>

  <dl class="mt-6 space-y-3 border-t border-ink-100 pt-6 text-[0.95rem]">
    <div>
      <dt class="eyebrow text-ink-500">Email</dt>
      <dd class="mt-1.5">
        <a
          href={`mailto:${CONTACT.general}`}
          class="text-ice-600 underline underline-offset-4 hover:text-ice-500"
        >
          {CONTACT.general}
        </a>
        <p class="mt-1.5 text-xs leading-relaxed text-ink-500">
          Employer enquiries. Separate from the candidate inbox at {CONTACT.applications}.
        </p>
      </dd>
    </div>
    <div>
      <dt class="eyebrow text-ink-500">Phone</dt>
      <dd class="mt-1.5">
        <a href={CONTACT.phoneHref} class="text-ice-600 hover:text-ice-500">{CONTACT.phone}</a>
      </dd>
    </div>
    {
      linkedin && (
        <div>
          <dt class="eyebrow text-ink-500">LinkedIn</dt>
          <dd class="mt-1.5">
            <a
              href={linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-ice-600 underline underline-offset-4 hover:text-ice-500"
            >
              Profile
            </a>
          </dd>
        </div>
      )
    }
  </dl>

  {
    booking && (
      <div class="mt-6 border-t border-ink-100 pt-6">
        <a
          href={BOOKING.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-[0.95rem] font-medium text-ice-600 underline underline-offset-4 hover:text-ice-500"
        >
          {BOOKING.label}
          <svg
            class="h-3.5 w-3.5"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <path d="M6 3.5h6.5V10M12.5 3.5L4 12" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <p class="mt-2 text-xs text-ink-500">{BOOKING.note}</p>
      </div>
    )
  }
</div>
