---
import { CONTACT, LEGAL, BOOKING } from '../consts';

interface Props {
  /** 'surface' on light backgrounds, 'dark' on the ink panels. */
  tone?: 'surface' | 'dark';
  /** Render the public booking link. Employer-facing blocks only. */
  booking?: boolean;
  /** Shown above the name. Keep it factual. */
  eyebrow?: string;
  /** One or two sentences on what dealing with this person means. */
  lead?: string;
  class?: string;
}

const {
  tone = 'surface',
  booking = false,
  eyebrow = 'Who you speak to',
  lead = 'The person who answers is the person who does the work. Nothing is passed to a delivery team.',
  class: className = '',
} = Astro.props;

const isDark = tone === 'dark';

const shell = isDark
  ? 'rounded-2xl bg-ink-900/60 p-7 ring-1 ring-ink-800 sm:p-8'
  : 'rounded-2xl bg-white p-7 ring-1 ring-ink-100 sm:p-8';
const eyebrowCls = isDark ? 'text-ice-400' : 'text-ice-600';
const nameCls = isDark ? 'text-white' : 'text-ink-950';
const roleCls = isDark ? 'text-ink-300' : 'text-ink-500';
const bodyCls = isDark ? 'text-ink-200' : 'text-ink-600';
const ruleCls = isDark ? 'border-ink-800' : 'border-ink-100';
const linkCls = isDark
  ? 'text-ice-300 hover:text-ice-100'
  : 'text-ice-600 hover:text-ice-500';

const person = LEGAL.responsibleParty;
const title = LEGAL.responsibleTitle;
---

<div class={`${shell} ${className}`}>
  <p class={`eyebrow ${eyebrowCls}`}>{eyebrow}</p>

  <p class={`mt-3 font-display text-xl font-semibold tracking-tight ${nameCls}`}>{person}</p>
  {title && <p class={`mt-1 text-sm ${roleCls}`}>{title}, Diamond Recruiters</p>}

  <p class={`mt-4 text-[0.95rem] leading-relaxed ${bodyCls}`}>{lead}</p>

  <dl class={`mt-6 space-y-3 border-t pt-6 text-[0.95rem] ${ruleCls}`}>
    <div>
      <dt class={`eyebrow ${roleCls}`}>Email</dt>
      <dd class="mt-1.5">
        <a href={`mailto:${CONTACT.general}`} class={`${linkCls} underline underline-offset-4`}>
          {CONTACT.general}
        </a>
      </dd>
    </div>
    <div>
      <dt class={`eyebrow ${roleCls}`}>Phone</dt>
      <dd class="mt-1.5">
        <a href={CONTACT.phoneHref} class={linkCls}>{CONTACT.phone}</a>
      </dd>
    </div>
  </dl>

  {
    booking && (
      <div class={`mt-6 border-t pt-6 ${ruleCls}`}>
        <a
          href={BOOKING.url}
          target="_blank"
          rel="noopener noreferrer"
          class={`inline-flex items-center gap-2 text-[0.95rem] font-medium underline underline-offset-4 ${linkCls}`}
        >
          {BOOKING.label}
          <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M6 3.5h6.5V10M12.5 3.5L4 12" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <p class={`mt-2 text-xs ${roleCls}`}>{BOOKING.note}</p>
      </div>
    )
  }
</div>
