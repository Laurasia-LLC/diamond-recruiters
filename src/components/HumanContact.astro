---
import { CONTACT, LEGAL, founderFor, bookingFor } from '../consts';
import type { Locale } from '../lib/locale';
import { detectLocaleFromPath } from '../lib/locale';

interface Props {
  booking?: boolean;
  eyebrow?: string;
  lead?: string;
  class?: string;
  locale?: Locale;
}

const {
  booking: showBooking = false,
  eyebrow,
  lead,
  class: className = '',
  locale = detectLocaleFromPath(Astro.url.pathname),
} = Astro.props;

const founder = founderFor(locale);
const booking = bookingFor(locale);
const eyebrowText =
  eyebrow ??
  (locale === 'de' ? 'Ihr Ansprechpartner' : 'Who you speak to');
const leadText = lead ?? founder.lead;

const linkedin = CONTACT.social.linkedin || null;
const appsNote =
  locale === 'de'
    ? `Arbeitgeber-Anfragen. Getrennt vom Kandidaten-Postfach ${CONTACT.applications}.`
    : `Employer enquiries. Separate from the candidate inbox at ${CONTACT.applications}.`;
---

<div class={`rounded-2xl bg-white p-7 ring-1 ring-ink-100 sm:p-8 ${className}`}>
  <p class="eyebrow text-ice-600">{eyebrowText}</p>

  <p class="mt-3 font-display text-xl font-semibold tracking-tight text-ink-950">
    {LEGAL.responsibleParty}
  </p>
  {
    LEGAL.responsibleTitle && (
      <p class="mt-1 text-sm text-ink-500">
        {LEGAL.responsibleTitle}, Diamond Recruiters
      </p>
    )
  }

  <p class="mt-4 text-[0.95rem] leading-relaxed text-ink-600">{leadText}</p>

  <dl class="mt-6 space-y-3 border-t border-ink-100 pt-6 text-[0.95rem]">
    <div>
      <dt class="eyebrow text-ink-500">Email</dt>
      <dd class="mt-1.5">
        <a
          href={`mailto:${CONTACT.general}`}
          class="text-ice-600 underline underline-offset-4 hover:text-ice-500"
        >
          {CONTACT.general}
        </a>
        <p class="mt-1.5 text-xs leading-relaxed text-ink-500">{appsNote}</p>
      </dd>
    </div>
    {
      linkedin && (
        <div>
          <dt class="eyebrow text-ink-500">LinkedIn</dt>
          <dd class="mt-1.5">
            <a
              href={linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-ice-600 underline underline-offset-4 hover:text-ice-500"
            >
              Profile
            </a>
          </dd>
        </div>
      )
    }
  </dl>

  {
    showBooking && (
      <div class="mt-6 border-t border-ink-100 pt-6">
        <a
          href={booking.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-[0.95rem] font-medium text-ice-600 underline underline-offset-4 hover:text-ice-500"
        >
          {booking.label}
          <svg
            class="h-3.5 w-3.5"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <path d="M6 3.5h6.5V10M12.5 3.5L4 12" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <p class="mt-2 text-xs text-ink-500">{booking.note}</p>
      </div>
    )
  }
</div>
