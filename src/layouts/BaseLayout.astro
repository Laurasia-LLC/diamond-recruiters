---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../lib/locale';
import { LOCALES, detectLocaleFromPath } from '../lib/locale';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | null;
  headerOverDark?: boolean;
  locale?: Locale;
}

const {
  title,
  description,
  image,
  noindex,
  schema,
  headerOverDark = true,
  locale = detectLocaleFromPath(Astro.url.pathname),
} = Astro.props;

const skip =
  locale === 'de' ? 'Zum Inhalt springen' : 'Skip to content';
---

<!doctype html>
<html lang={LOCALES[locale].htmlLang}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      noindex={noindex}
      schema={schema}
      locale={locale}
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-ink-900 focus:px-5 focus:py-2.5 focus:text-sm focus:text-white"
    >
      {skip}
    </a>

    <Header overDark={headerOverDark} locale={locale} />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer locale={locale} />
  </body>
</html>
