---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | null;
  /**
   * Set false on pages that open on a light background, so the header renders
   * dark type instead of light. Most pages open with a dark hero.
   */
  headerOverDark?: boolean;
}

const {
  title,
  description,
  image,
  noindex,
  schema,
  headerOverDark = true,
} = Astro.props;
---

<!doctype html>
<html lang="en-US">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      noindex={noindex}
      schema={schema}
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-ink-900 focus:px-5 focus:py-2.5 focus:text-sm focus:text-white"
    >
      Skip to content
    </a>

    <Header overDark={headerOverDark} />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
