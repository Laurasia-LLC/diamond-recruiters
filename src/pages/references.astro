---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ReferenceQuotes from '../components/ReferenceQuotes.astro';
import CTABand from '../components/CTABand.astro';
---

<BaseLayout
  title="References"
  description="Signed reference letters about Philipp Hoffschröer's recruitment work, reproduced with permission from skytz-consulting.com."
  headerOverDark={false}
>
  <section class="border-b border-ink-100 bg-ink-950">
    <div class="mx-auto max-w-7xl px-5 pb-16 pt-16 lg:px-8 lg:pb-20 lg:pt-24">
      <p class="eyebrow text-ice-400">References</p>
      <h1 class="mt-4 max-w-3xl text-4xl leading-[1.1] text-white sm:text-5xl">
        Named clients, exact wording
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-200">
        Letters written about Philipp's recruitment work for industrial and specialist
        employers — mostly in Europe — before and alongside Diamond's US technical sales
        focus. Nothing here is rewritten as a US placement statistic.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-24">
    <SectionHeading
      eyebrow="Signed letters"
      title="What past clients said"
      lead="Reproduced verbatim from the public references on skytz-consulting.com, with signatory names and roles as published there."
    />
    <ReferenceQuotes class="mt-14" showAttribution />
  </section>

  <CTABand
    eyebrow="Employers"
    title="Starting a US technical sales search?"
    lead="Book a scoping call or send a brief. Candidates should use the separate apply path."
    primaryHref="/for-employers#brief"
    primaryLabel="Brief a role"
    secondaryHref="/for-candidates"
    secondaryLabel="For candidates"
  />
</BaseLayout>
