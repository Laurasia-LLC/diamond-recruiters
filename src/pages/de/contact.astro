---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmployerConversion from '../../components/EmployerConversion.astro';
import HumanContact from '../../components/HumanContact.astro';
import { CONTACT } from '../../consts';
import { localePath } from '../../lib/locale';

const locale = 'de' as const;

const routes = [
  {
    eyebrow: 'Einstellung',
    title: 'Sie müssen eine Stelle besetzen',
    body: 'Buchen Sie ein Gespräch mit Philipp oder schreiben Sie hello@ mit Rolle, Gebiet und Gehaltsband.',
    href: `${localePath(locale, '/for-employers')}#brief`,
    label: 'Suche starten',
  },
  {
    eyebrow: 'Karriere',
    title: 'Sie suchen Ihr nächstes Gebiet',
    body: 'Senden Sie Ihren Lebenslauf mit Basisstadt, benötigtem OTE und Reiseradius.',
    href: `${localePath(locale, '/for-candidates')}#general-application`,
    label: 'Lebenslauf senden',
  },
];
---

<BaseLayout
  title="Kontakt"
  description="Kontakt zu Diamond Recruiters — technischer Vertriebs-Recruiting in US-Industrie: Automation, Prozessinstrumentierung und Flow Control."
  headerOverDark={false}
  locale={locale}
>
  <section class="border-b border-ink-100 bg-ink-950">
    <div class="mx-auto max-w-7xl px-5 pb-16 pt-16 lg:px-8 lg:pb-20 lg:pt-24">
      <p class="eyebrow text-ice-400">Kontakt</p>
      <h1 class="mt-4 max-w-3xl text-4xl leading-[1.1] text-white sm:text-5xl">
        Mit einer Person sprechen
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-200">
        Arbeitgebergespräche laufen über Gründer Philipp Hoffschröer — Kalenderlink oder{' '}
        {CONTACT.general}. Kandidatenbewerbungen über {CONTACT.applications} auf den
        Kandidatenseiten. Keine öffentliche Telefonnummer auf dieser Website.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-20">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <h2 class="text-xl">Direkt</h2>

        <div class="mt-7">
          <HumanContact eyebrow="Gründer" booking locale={locale} />
        </div>

        <dl class="mt-9 space-y-7 border-t border-ink-100 pt-7">
          <div>
            <dt class="eyebrow text-ink-400">Registrierte Anschrift</dt>
            <dd class="mt-2 text-[0.975rem] not-italic leading-relaxed text-ink-700">
              <address class="not-italic">
                {CONTACT.address.line1}<br />
                {CONTACT.address.city}, {CONTACT.address.region} {CONTACT.address.postalCode}<br />
                {CONTACT.address.countryName}
              </address>
              <p class="mt-1.5 text-sm text-ink-500">
                Rechtliche und postalische Anschrift. Suchen laufen remote und beim Kunden vor Ort.
              </p>
            </dd>
          </div>

          <div>
            <dt class="eyebrow text-ink-400">Abdeckung</dt>
            <dd class="mt-2 text-[0.975rem] leading-relaxed text-ink-700">
              Suchen in den gesamten Vereinigten Staaten.
            </dd>
          </div>
        </dl>
      </div>

      <div class="lg:col-span-8">
        <div class="rounded-2xl bg-white p-7 ring-1 ring-ink-100 sm:p-9">
          <h2 class="text-xl">Arbeitgeber</h2>
          <p class="mt-2.5 text-[0.95rem] leading-relaxed text-ink-600">
            Primärer Weg: Kalender und hello@ — kein PHP-Formular auf diesem Host.
          </p>
          <div class="mt-8">
            <EmployerConversion locale={locale} id="employer-contact" />
          </div>
        </div>
      </div>
    </div>

    <div class="mt-16 grid gap-6 sm:grid-cols-2">
      {
        routes.map((route) => (
          <a
            href={route.href}
            class="group rounded-2xl bg-sand-100 p-8 transition-all duration-300 ease-out-expo hover:-translate-y-1 hover:bg-sand-200/70 hover:shadow-lg hover:shadow-ink-900/6"
          >
            <p class="eyebrow text-ice-600">{route.eyebrow}</p>
            <h3 class="mt-3 text-xl text-ink-950">{route.title}</h3>
            <p class="mt-3 leading-relaxed text-ink-600">{route.body}</p>
            <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-ink-900">
              {route.label}
              <svg
                class="h-4 w-4 transition-transform duration-300 ease-out-expo group-hover:translate-x-1"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                aria-hidden="true"
              >
                <path d="M2.5 8h11M9 3.5L13.5 8 9 12.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
