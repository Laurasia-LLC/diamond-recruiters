---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CTABand from '../../components/CTABand.astro';
import FounderPanel from '../../components/FounderPanel.astro';
import Button from '../../components/Button.astro';
import { proofFor, sectorsFor } from '../../consts';
import { localePath } from '../../lib/locale';
import heroImage from '../../assets/founder-philipp-hoffschroer.jpg';
import gaugesImage from '../../assets/accent-control-gauges.jpg';

const locale = 'de' as const;
const PROOF = proofFor(locale);
const SECTORS = sectorsFor(locale);

const principles = [
  {
    title: 'Eng schlägt breit',
    body: 'Wir rekrutieren in Industrieautomation, Prozessinstrumentierung und Flow Control. Mehr nicht. Eine Generalistenagentur muss erst erklären bekommen, was ein Regelventil ist, bevor sie jemanden findet, der es verkauft.',
  },
  {
    title: 'Unangenehmes früh sagen',
    body: 'Das Band ist zu niedrig. Die Stellenbeschreibung beschreibt zwei Menschen. Der Kandidat ist technisch stark, hat aber nie eine Quote getragen. Das in Woche eins zu sagen bringt mehr als Zustimmung bis Woche acht.',
  },
  {
    title: 'Vertraulichkeit ist kein Feature',
    body: 'Sie ist die Basis. Nichts über einen Kandidaten geht an einen Kunden — und nichts über einen Kunden an den Markt — ohne vorherige Freigabe.',
  },
  {
    title: 'Ehrlich, wenn es nicht passt',
    body: 'Wenn Briefing, Band oder Timing nicht zusammenpassen, sagen wir das früh, statt eine Suche zu fahren, die nie zum Abschluss kommt.',
  },
];
---

<BaseLayout
  title="Über uns"
  description="Diamond Recruiters: spezialisierte Suche im technischen Vertrieb für US-Industrie — Automation, Prozessinstrumentierung und Flow Control."
  locale={locale}
>
  <section class="relative isolate -mt-[89px] overflow-hidden bg-ink-950 pt-[89px]">
    <Image
      src={heroImage}
      alt="Philipp Hoffschröer, Gründer von Diamond Recruiters"
      widths={[800, 1400, 1800]}
      sizes="100vw"
      class="absolute inset-0 -z-10 h-full w-full object-cover object-[center_20%] opacity-40"
      loading="eager"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 -z-10 bg-linear-to-br from-ink-950/95 via-ink-950/88 to-ink-900/70"
      aria-hidden="true"
    >
    </div>

    <div class="mx-auto max-w-7xl px-5 pb-20 pt-16 lg:px-8 lg:pb-24 lg:pt-24">
      <p class="eyebrow text-ice-400">Über uns</p>
      <h1 class="mt-5 max-w-4xl text-4xl leading-[1.1] text-white sm:text-5xl">
        Technischer Vertrieb in der US-Industrieproduktion.
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-ink-100">
        Diamond Recruiters besetzt technische Vertriebskräfte bei Industrieherstellern und
        Vertriebspartnern in den Vereinigten Staaten — Schwerpunkte Automation, Prozessinstrumentierung
        und Flow Control.
      </p>
    </div>
  </section>

  <section class="border-b border-ink-100 bg-white">
    <div class="mx-auto max-w-7xl px-5 py-14 lg:px-8 lg:py-16">
      <dl class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          PROOF.map((item) => (
            <div class="border-t-2 border-ice-600 pt-5">
              <dt class="font-display text-lg font-semibold tracking-tight text-ink-950">
                {item.title}
              </dt>
              <dd class="mt-2.5 text-sm leading-relaxed text-ink-500">{item.detail}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHeading eyebrow="Was wir tun" title="Technischer Vertrieb, Industriemärkte." />
        <div class="mt-8 overflow-hidden rounded-2xl">
          <Image
            src={gaugesImage}
            alt="Analoge Messinstrumente an einem Schaltschrank"
            widths={[500, 900]}
            sizes="(min-width: 1024px) 38vw, 92vw"
            class="h-56 w-full object-cover"
            loading="lazy"
          />
        </div>
      </div>

      <div class="space-y-5 text-lg leading-relaxed text-ink-600 lg:col-span-7">
        <p>
          Sensoren, Instrumentierung oder Flow Control zu verkaufen ist kein generischer Vertrieb.
          Die Person muss ins Werk gehen, verstehen, warum die Messtechnik versagt oder das Ventil
          überdimensioniert ist — und daraus eine Empfehlung machen, die ein Controls Engineer
          annimmt.
        </p>
        <p>
          Das können nur wenige. Noch weniger suchen gerade einen neuen Job, wenn Sie jemanden
          brauchen. Die Suche ist Direktansprache — geführt von jemandem, der technisch glaubwürdig
          genug ist, dass ein erfolgreicher Sales Engineer länger als dreißig Sekunden am Telefon
          bleibt.
        </p>
        <p class="text-ink-900">
          Das ist die ganze Prämisse. Wir wollen nicht alles für alle sein — wir konzentrieren uns
          auf technischen Industrievertrieb in diesen Segmenten.
        </p>
      </div>
    </div>
  </section>

  <section class="border-y border-ink-100 bg-sand-100/60">
    <div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
      <SectionHeading
        eyebrow="Wie wir arbeiten"
        title="Vier Prinzipien, nach denen wir wirklich handeln"
        lead="Festgehalten, damit beide Seiten uns daran messen können."
      />

      <div class="mt-14 grid gap-x-10 gap-y-11 sm:grid-cols-2">
        {
          principles.map((item, i) => (
            <div class="border-t border-ink-200 pt-6">
              <span class="font-mono text-sm text-ice-600">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-2.5 text-xl text-ink-950">{item.title}</h3>
              <p class="mt-3 leading-relaxed text-ink-600">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-24">
    <SectionHeading
      eyebrow="Abdeckung"
      title="Märkte und Gebiete"
      lead="Suchen landesweit in den USA — mit Schwerpunkt dort, wo Industrieproduktion sitzt."
    />

    <div class="mt-12 grid gap-px overflow-hidden rounded-2xl bg-ink-100 sm:grid-cols-2 lg:grid-cols-3">
      {
        SECTORS.map((sector) => (
          <div class="bg-white p-7">
            <h3 class="font-display font-semibold text-ink-950">{sector.name}</h3>
            <p class="mt-2 text-[0.925rem] leading-relaxed text-ink-600">{sector.detail}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-t border-ink-100 bg-white">
    <div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-24">
      <FounderPanel booking locale={locale} />
      <div class="mt-12">
        <Button href={localePath(locale, '/references')} variant="secondary">
          Referenzen lesen
        </Button>
      </div>
    </div>
  </section>

  <CTABand
    title="Egal auf welcher Seite des Tisches — starten Sie mit einem Gespräch."
    lead="Unverbindlich, ohne Druck, mit einer ehrlichen Antwort, ob wir helfen können. Wenn nicht, kennen wir oft jemanden, der kann."
    primaryHref={localePath(locale, '/contact')}
    primaryLabel="Kontakt aufnehmen"
    secondaryHref={localePath(locale, '/jobs')}
    secondaryLabel="Offene Stellen"
  />
</BaseLayout>
