---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ApplicationForm from '../components/ApplicationForm.astro';
import JobCard from '../components/JobCard.astro';
import { isLive } from '../lib/jobStatus';
import heroImage from '../assets/candidates-plant-floor.jpg';

const jobs = (await getCollection('jobs', ({ data }) => isLive(data))).sort(
  (a, b) => a.data.order - b.data.order
);

const promises = [
  {
    title: 'The band, before the loop',
    body: 'We tell you the client, the territory and the real salary band on the first call. If it comes in under what you need, we say so and stop there. Nobody spends four rounds finding out the money was never going to work.',
  },
  {
    title: 'Nothing moves without your say-so',
    body: 'Your resume does not go anywhere until you have said yes to that specific company. No spraying, no "we had you on file", no call from your current employer asking why they saw your CV.',
  },
  {
    title: 'We tell you when it is not a fit',
    body: 'Including when it is us who cannot help. A straight no today is worth more to you than a polite maybe that goes quiet for three weeks.',
  },
  {
    title: 'Real prep, not a briefing sheet',
    body: 'Before you meet anyone we tell you who is in the room, what they care about, what the last person in the seat got wrong, and where they are likely to push you.',
  },
];

const faqs = [
  {
    q: 'Will my current employer find out?',
    a: 'Not from us. We never send your details to a company without your explicit approval for that company, by name, first. If there is an employer you specifically want us to avoid, tell us and we block it.',
  },
  {
    q: 'What if I am not looking right now?',
    a: 'That is normally who we are calling. If nothing fits today, we would rather stay in touch and come back when something does. Nobody gets added to a mailing list.',
  },
  {
    q: 'Do I pay anything?',
    a: 'No. Candidates never pay us, for anything, at any stage. Our fee is paid by the hiring company.',
  },
  {
    q: 'Why do you ask for my salary expectation up front?',
    a: 'Because we work to it honestly rather than around it. If your number is above the band we tell you immediately instead of using it as a negotiating lever against you.',
  },
  {
    q: 'What happens to my resume if there is no fit?',
    a: 'We keep it so we can come back to you when something relevant opens, and you can ask us to delete it at any time. See the Privacy Policy for the detail.',
  },
  {
    q: 'How quickly will I hear back?',
    a: 'Within one business day, from a person. Even when the answer is no.',
  },
];
---

<BaseLayout
  title="For Candidates"
  description="Sales engineer roles in US industrial automation, process instrumentation and flow control. We name the real salary band on the first call, and nothing moves without your approval."
>
  <section class="relative isolate -mt-[89px] overflow-hidden bg-ink-950 pt-[89px]">
    <Image
      src={heroImage}
      alt="Engineers working beside a circular conveyor system on a plant floor"
      widths={[800, 1400, 1800]}
      sizes="100vw"
      class="absolute inset-0 -z-10 h-full w-full object-cover opacity-40"
      loading="eager"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 -z-10 bg-linear-to-br from-ink-950/95 via-ink-950/85 to-ink-900/70"
      aria-hidden="true"
    >
    </div>

    <div class="mx-auto max-w-7xl px-5 pb-20 pt-16 lg:px-8 lg:pb-24 lg:pt-24">
      <p class="eyebrow text-ice-400">For candidates</p>
      <h1 class="mt-5 max-w-4xl text-4xl leading-[1.1] text-white sm:text-5xl">
        You should know the number before you spend your evenings on interviews.
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-ink-100">
        We work with sales engineers, applications engineers and technical sales leaders
        across US industrial manufacturing. Straight answers, confidential throughout, and
        no pressure to move for the sake of a fee.
      </p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a
          href="/jobs"
          class="inline-flex items-center justify-center rounded-full bg-ice-500 px-7 py-3.5 text-base font-semibold text-ink-950 shadow-sm transition-all duration-200 ease-out-expo hover:-translate-y-px hover:bg-ice-400 hover:shadow-lg"
        >
          See open roles ({jobs.length})
        </a>
        <a
          href="#general-application"
          class="inline-flex items-center justify-center rounded-full bg-white/10 px-7 py-3.5 text-base font-medium text-white ring-1 ring-white/25 backdrop-blur-sm transition-all duration-200 ease-out-expo hover:-translate-y-px hover:bg-white/20"
        >
          Send your resume
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== OUR PROMISES ===================== -->
  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
    <SectionHeading
      eyebrow="What you can expect"
      title="Four things we will not do to you"
      lead="Every one of these exists because it is what people tell us went wrong last time they worked with a recruiter."
    />

    <div class="mt-14 grid gap-6 sm:grid-cols-2">
      {
        promises.map((item) => (
          <div class="rounded-2xl bg-white p-8 ring-1 ring-ink-100 transition-all duration-300 ease-out-expo hover:-translate-y-1 hover:shadow-lg hover:shadow-ink-900/6">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-ice-100">
              <svg class="h-4 w-4 text-ice-600" viewBox="0 0 16 16" fill="currentColor">
                <path d="M8 0.5l2.2 5.3 5.3 2.2-5.3 2.2L8 15.5l-2.2-5.3L0.5 8l5.3-2.2z" />
              </svg>
            </div>
            <h3 class="mt-5 text-lg">{item.title}</h3>
            <p class="mt-3 leading-relaxed text-ink-600">{item.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ===================== WHAT WE ASK ===================== -->
  <section class="border-y border-ink-100 bg-ink-950">
    <div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <SectionHeading
            eyebrow="In return"
            title="What we ask of you"
            tone="light"
          />
        </div>
        <div class="space-y-6 lg:col-span-7">
          <p class="text-lg leading-relaxed text-ink-200">
            One number you can defend in conversation. Quota attainment, year-on-year
            growth, a named account you won and how you won it. Not a target you were
            given — a result you produced.
          </p>
          <p class="text-lg leading-relaxed text-ink-200">
            And tell us the truth about your situation: what you actually earn, what would
            genuinely make you move, and whether you are talking to anyone else. We can
            work with almost anything except a surprise in week six.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== OPEN ROLES ===================== -->
  {
    jobs.length > 0 && (
      <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-24">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <SectionHeading eyebrow="Live now" title="Open roles" class="mb-0" />
          <a
            href="/jobs"
            class="text-sm font-medium text-ice-600 underline underline-offset-4 hover:text-ice-500"
          >
            View all
          </a>
        </div>
        <div class="mt-12 grid gap-7 md:grid-cols-2 xl:grid-cols-3">
          {jobs.map((job) => (
            <JobCard job={job} />
          ))}
        </div>
      </section>
    )
  }

  <!-- ===================== FAQ ===================== -->
  <section class="border-y border-ink-100 bg-white">
    <div class="mx-auto max-w-3xl px-5 py-20 lg:px-8 lg:py-24">
      <SectionHeading eyebrow="Questions" title="The ones people actually ask" />

      <div class="mt-12 divide-y divide-ink-100 border-y border-ink-100">
        {
          faqs.map((faq) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4">
                <span class="font-display text-[1.05rem] font-medium text-ink-950">{faq.q}</span>
                <svg
                  class="h-5 w-5 shrink-0 text-ink-400 transition-transform duration-300 ease-out-expo group-open:rotate-45"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  aria-hidden="true"
                >
                  <path d="M10 4v12M4 10h12" stroke-linecap="round" />
                </svg>
              </summary>
              <p class="mt-3.5 max-w-2xl leading-relaxed text-ink-600">{faq.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== GENERAL APPLICATION ===================== -->
  <section class="bg-sand-100/70" id="general-application">
    <div class="mx-auto max-w-3xl px-5 py-20 lg:px-8 lg:py-24">
      <p class="eyebrow text-ice-600">General application</p>
      <h2 class="mt-3 text-3xl leading-tight sm:text-4xl">Send us your resume</h2>
      <p class="mt-5 leading-relaxed text-ink-600">
        Most of what we work on never gets posted — clients ask us to run searches
        confidentially and they fill from people already on our radar. Get on it. We will
        tell you honestly whether we are likely to have something for you.
      </p>

      <div class="mt-10 rounded-2xl bg-white p-7 ring-1 ring-ink-100 sm:p-9">
        <ApplicationForm id="general-apply" />
      </div>
    </div>
  </section>
</BaseLayout>
