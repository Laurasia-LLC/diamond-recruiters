---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { CONTACT } from '../consts';

const routes = [
  {
    eyebrow: 'Hiring',
    title: 'You need to fill a seat',
    body: 'Tell us the role, the territory and the band. We will come back with a straight read on whether it is findable at that number.',
    href: '/for-employers#brief',
    label: 'Brief us on a role',
  },
  {
    eyebrow: 'Looking',
    title: 'You want your next territory',
    body: 'Send your resume with your base city, the OTE you need and how far you will travel. A person reads it and replies.',
    href: '/for-candidates#general-application',
    label: 'Send your resume',
  },
];
---

<BaseLayout
  title="Contact"
  description="Get in touch with Diamond Recruiters — technical sales search for US industrial automation, process instrumentation and flow control."
>
  <section class="border-b border-ink-100 bg-ink-950">
    <div class="mx-auto max-w-7xl px-5 pb-16 pt-16 lg:px-8 lg:pb-20 lg:pt-24">
      <p class="eyebrow text-ice-400">Contact</p>
      <h1 class="mt-4 max-w-3xl text-4xl leading-[1.1] text-white sm:text-5xl">Talk to a person</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-200">
        Every message reaches someone who works on these searches directly. We reply within
        one business day — including when the answer is that we cannot help.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-20">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
      <!-- Details -->
      <div class="lg:col-span-4">
        <h2 class="text-xl">Direct</h2>

        <dl class="mt-7 space-y-7">
          <div>
            <dt class="eyebrow text-ink-400">Applications</dt>
            <dd class="mt-2">
              <a
                href={`mailto:${CONTACT.applications}`}
                class="text-[0.975rem] text-ice-600 underline underline-offset-4 hover:text-ice-500"
              >
                {CONTACT.applications}
              </a>
              <p class="mt-1.5 text-sm text-ink-500">Resumes and role enquiries.</p>
            </dd>
          </div>

          <div>
            <dt class="eyebrow text-ink-400">General</dt>
            <dd class="mt-2">
              <a
                href={`mailto:${CONTACT.general}`}
                class="text-[0.975rem] text-ice-600 underline underline-offset-4 hover:text-ice-500"
              >
                {CONTACT.general}
              </a>
              <p class="mt-1.5 text-sm text-ink-500">Everything else.</p>
            </dd>
          </div>

          <div>
            <dt class="eyebrow text-ink-400">Phone</dt>
            <dd class="mt-2">
              <a
                href={CONTACT.phoneHref}
                class="text-[0.975rem] text-ink-900 transition-colors hover:text-ice-600"
              >
                {CONTACT.phone}
              </a>
            </dd>
          </div>

          <div>
            <dt class="eyebrow text-ink-400">Office</dt>
            <dd class="mt-2 text-[0.975rem] not-italic leading-relaxed text-ink-700">
              <address class="not-italic">
                {CONTACT.address.line1}<br />
                {CONTACT.address.city}, {CONTACT.address.region} {CONTACT.address.postalCode}<br />
                {CONTACT.address.countryName}
              </address>
            </dd>
          </div>

          <div>
            <dt class="eyebrow text-ink-400">Coverage</dt>
            <dd class="mt-2 text-[0.975rem] leading-relaxed text-ink-700">
              Searches run nationwide across the United States.
            </dd>
          </div>
        </dl>
      </div>

      <!-- Form -->
      <div class="lg:col-span-8">
        <div class="rounded-2xl bg-white p-7 ring-1 ring-ink-100 sm:p-9">
          <h2 class="text-xl">Send a message</h2>
          <p class="mt-2.5 text-[0.95rem] leading-relaxed text-ink-600">
            If you are hiring or applying, the dedicated forms below capture what we need
            to be useful straight away.
          </p>
          <div class="mt-8">
            <ContactForm variant="general" id="general-contact" />
          </div>
        </div>
      </div>
    </div>

    <!-- Routes -->
    <div class="mt-16 grid gap-6 sm:grid-cols-2">
      {
        routes.map((route) => (
          <a
            href={route.href}
            class="group rounded-2xl bg-sand-100 p-8 transition-all duration-300 ease-out-expo hover:-translate-y-1 hover:bg-sand-200/70 hover:shadow-lg hover:shadow-ink-900/6"
          >
            <p class="eyebrow text-ice-600">{route.eyebrow}</p>
            <h3 class="mt-3 text-xl text-ink-950">{route.title}</h3>
            <p class="mt-3 leading-relaxed text-ink-600">{route.body}</p>
            <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-ink-900">
              {route.label}
              <svg
                class="h-4 w-4 transition-transform duration-300 ease-out-expo group-hover:translate-x-1"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                aria-hidden="true"
              >
                <path d="M2.5 8h11M9 3.5L13.5 8 9 12.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
